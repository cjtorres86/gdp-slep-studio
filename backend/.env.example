# GDP-SLEP Studio (portal) — copia este archivo como ".env" y ajusta los valores.
NODE_ENV=development
PORT=3100

# Base de datos DEL PORTAL (distinta a la de Avance de Sumarios).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gdp_app
DB_PASSWORD=gdp_app_dev_pw
DB_DATABASE=gdp_portal
DB_SSL=false

# Firma de las sesiones del portal. En producción: un valor largo y aleatorio, solo en Render.
JWT_SECRET=cambiar-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Dirección(es) del frontend del portal, separadas por coma (CORS).
FRONTEND_URL=http://localhost:4300
